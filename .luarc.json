{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "pathStrict": true,
    "version": "LuaJIT"
  },
  "diagnostics": {
    "unusedLocalExclude": [
      "_*"
    ],
    "disable": [
      "redefined-local"
    ]
  },
  "workspace": {
    "library": [
      "lua",
      "$VIMRUNTIME/lua",
      "${3rd}/luv/library",
    ],
    "checkThirdParty": false
  }
}
